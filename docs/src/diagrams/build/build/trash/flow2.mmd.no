    subgraph BVPSO["Boundary Value Problem Solution"]

    EvaluationMethod["EvaluationMethod"]
    CauchyIntegral["CauchyIntegral"]
    PotentialTheory["PotentialTheory"]
    DistancePolicy["DistancePolicy"]
