    end



%% input

%% output
    PDE -.equation.- BVP
    Curve -. boundary .- BVP
    BoundaryCondition -. bc .- BVP
    Side -. side .- BVP
    BVP -. bvp .- BIE
    Laplace -- subtype -->PDE
    Helmholtz -- subtype -->PDE
    Stokes -- subtype -->PDE
    Neumann -- subtype -->BoundaryCondition
    Dirichlet -- subtype -->BoundaryCondition
    Interior -- subtype --> Side
    Exterior -- subtype --> Side

    PotentialTheory -. method .- DirectBVP
    EvaluationMethod -. method .- IndirectBVP
    DirectBVP -- subtype --> BVPAlg
    IndirectBVP -- subtype --> BVPAlg
    CauchyIntegral -- subtype --> EvaluationMethod
    PotentialTheory -- subtype --> EvaluationMethod
    DistancePolicy -- subtype --> EvaluationMethod

    BIE -- input --> SolveBIE
    BIEAlg -- input --> SolveBIE
    DirectBIE -- subtype --> BIEAlg
    IndirectBIE -- subtype --> BIEAlg
    SingularCorrection -. "Diri. BC" .- DirectBIE
    HypersingularCorrection -. "Neum. BC" .- DirectBIE
    KapurRokhlin -- subtype --> SingularCorrection
    FiniteDifferences -- subtype --> HypersingularCorrection
    RichardsonExtrapolation -- subtype --> HypersingularCorrection

    BIESolution -- input --> SolveBVP


    BVPAlg -- input --> SolveBVP
    BVP -- input --> SolveBVP

    SolveBVP -- output --> BVPSolution
    SolveBIE -- output --> BIESolution

    %%SolveBDP --> BDPSolution["BDPSolution"]
