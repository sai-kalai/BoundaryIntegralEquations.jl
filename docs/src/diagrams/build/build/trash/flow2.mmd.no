    %%BVPS --> BIES --> BVPSO

    subgraph BIES["Boundary Integral Equation"]

    BIE["BIEProblem"]

    BIEAlg["BIEAlgorithm"]

    DirectBIE["DirectBIEAlgorithm"]
    IndirectBIE["IndirectBIEAlgorithm"]


    SingularCorrection["&lt;&lt;abstract&gt;&gt;<br/>SingularCorrection"]
